{
  "name": "labor-automation-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "npm run data:validate && tsx scripts/generate-pages.ts && vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:build": "tsx scripts/build-data.ts",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "release:check": "tsx scripts/release-check.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "html-to-image": "^1.11.13",
    "markdown-it": "^15.0.1",
    "vue": "3.5.42",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitepress": "1.6.4",
    "vitest": "5.0.0",
    "vue-tsc": "^3.2.5",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    },
    "sharp": "0.35.4"
  }
}
